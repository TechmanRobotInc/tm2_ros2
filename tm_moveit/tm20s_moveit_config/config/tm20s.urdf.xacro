<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tm20s">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import tm20s urdf file -->
    <xacro:include filename="$(find tm_description)/xacro/tm20s.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="tm20s.ros2_control.xacro" />


    <xacro:tm20s_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
