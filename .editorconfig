# EditorConfig is awesome: https://editorconfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
# Character set
charset = utf-8
# Indentation settings
indent_style = space
indent_size = 2
# End of line settings
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

# Matches multiple files with brace expansion notation
# Set default charset
[*.{js,py}]
charset = utf-8

[*.py]
indent_style = space
indent_size = 2
max_line_length = 100

# Tab indentation (no size specified)
[Makefile]
indent_style = tab

# Indentation override for all JS under lib directory
[lib/**.js]
indent_style = space
indent_size = 2

# Matches the exact files either package.json or .travis.yml
[{package.json,.travis.yml}]
indent_style = space
indent_size = 2

[*.[ch]]
indent_style = space
indent_size = 4
max_line_length = 100

[CMakeLists.txt]
indent_style = space
indent_size = 2
max_line_length = 100

[*.sh]
indent_style = space
indent_size = 2

[config/*.yaml]
end_of_line = crlf
indent_size = 2
indent_style = space

[*.md]
indent_size = unset
trim_trailing_whitespace = false
max_line_length = 100

[*.yml]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 4

[*.{vim,sh}]
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 80

[*.cs]
indent_size = 4

# Xml files
[*.xml]
indent_size = 2

