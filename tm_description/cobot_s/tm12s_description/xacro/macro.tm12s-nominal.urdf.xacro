<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find tm12s_description)/xacro/macro.inertial.xacro" />

  <xacro:macro name="tm12s" params="ns prefix color format dae_parse_gzskin
    joint_1_lower_limit:=${radians(-360)}    joint_1_upper_limit:=${radians(360)}
    joint_2_lower_limit:=${radians(-360)}    joint_2_upper_limit:=${radians(360)}
    joint_3_lower_limit:=${radians(-162)}    joint_3_upper_limit:=${radians(162)}
    joint_4_lower_limit:=${radians(-360)}    joint_4_upper_limit:=${radians(360)}
    joint_5_lower_limit:=${radians(-360)}    joint_5_upper_limit:=${radians(360)}
    joint_6_lower_limit:=${radians(-360)}    joint_6_upper_limit:=${radians(360)}
    joint_1_velocity_limit:=${radians(130)}
    joint_2_velocity_limit:=${radians(130)}
    joint_3_velocity_limit:=${radians(210)}
    joint_4_velocity_limit:=${radians(225)}
    joint_5_velocity_limit:=${radians(225)}
    joint_6_velocity_limit:=${radians(450)}
    joint_1_effort_limit:=${353}
    joint_2_effort_limit:=${353}
    joint_3_effort_limit:=${157}
    joint_4_effort_limit:=${54}
    joint_5_effort_limit:=${54}
    joint_6_effort_limit:=${34}
    safety_limits:=false safety_pos_margin:=0.15
    safety_k_position:=20">

    <xacro:property name="damping_factor" value="0.000"/>
    <xacro:property name="d1" value="${damping_factor*0.1}"/>
    <xacro:property name="d2" value="${damping_factor*0.1}"/>
    <xacro:property name="d3" value="${damping_factor*0.1}"/>
    <xacro:property name="d4" value="${damping_factor*0.1}"/>
    <xacro:property name="d5" value="${damping_factor*0.1}"/>
    <xacro:property name="d6" value="${damping_factor*0.1}"/>

    <xacro:property name="friction_factor" value="0.000"/>
    <xacro:property name="f1" value="${friction_factor*0.1}"/>
    <xacro:property name="f2" value="${friction_factor*0.1}"/>
    <xacro:property name="f3" value="${friction_factor*0.1}"/>
    <xacro:property name="f4" value="${friction_factor*0.1}"/>
    <xacro:property name="f5" value="${friction_factor*0.1}"/>
    <xacro:property name="f6" value="${friction_factor*0.1}"/>

    <!-- Inertia parameters -->
    <xacro:property name="mass_0" value="1.0" />
    <xacro:property name="mass_1" value="8.200" />
    <xacro:property name="mass_2" value="15.017" />
    <xacro:property name="mass_3" value="3.329" />
    <xacro:property name="mass_4" value="1.770" />
    <xacro:property name="mass_5" value="1.770" />
    <xacro:property name="mass_6" value="0.720" />

    <xacro:property name="unit_factor" value="0.000001"/>
    <xacro:property name="ixx_1" value="${25963.078*unit_factor}" />
    <xacro:property name="ixx_2" value="${56178.979*unit_factor}" />
    <xacro:property name="ixx_3" value="${4694.5431*unit_factor}" />
    <xacro:property name="ixx_4" value="${2046.0318*unit_factor}" />
    <xacro:property name="ixx_5" value="${2046.0318*unit_factor}" />
    <xacro:property name="ixx_6" value="${703.44734*unit_factor}" />

    <xacro:property name="iyy_1" value="${37671.229*unit_factor}" />
    <xacro:property name="iyy_2" value="${1212610.4*unit_factor}" />
    <xacro:property name="iyy_3" value="${134098.54*unit_factor}" />
    <xacro:property name="iyy_4" value="${3171.8293*unit_factor}" />
    <xacro:property name="iyy_5" value="${3171.8293*unit_factor}" />
    <xacro:property name="iyy_6" value="${1711.0225*unit_factor}" />

    <xacro:property name="izz_1" value="${38856.370*unit_factor}" />
    <xacro:property name="izz_2" value="${1231270.0*unit_factor}" />
    <xacro:property name="izz_3" value="${135525.91*unit_factor}" />
    <xacro:property name="izz_4" value="${3478.9518*unit_factor}" />
    <xacro:property name="izz_5" value="${3478.9518*unit_factor}" />
    <xacro:property name="izz_6" value="${1854.4783*unit_factor}" />

    <xacro:property name="unit_factor2" value="0.000001"/>
    <xacro:property name="cogx_1" value="${ -1.0522458*unit_factor2}" />
    <xacro:property name="cogy_1" value="${ -5411.0119*unit_factor2}" />
    <xacro:property name="cogz_1" value="${ -2423.0910*unit_factor2}" />
    <xacro:property name="cogx_2" value="${  234799.43*unit_factor2}" />
    <xacro:property name="cogy_2" value="${  0.0000000*unit_factor2}" />
    <xacro:property name="cogz_2" value="${ -182230.57*unit_factor2}" />
    <xacro:property name="cogx_3" value="${  368678.72*unit_factor2}" />
    <xacro:property name="cogy_3" value="${  1.9161889*unit_factor2}" />
    <xacro:property name="cogz_3" value="${ -55316.774*unit_factor2}" />
    <xacro:property name="cogx_4" value="${ -3.6473102*unit_factor2}" />
    <xacro:property name="cogy_4" value="${ -6381.2605*unit_factor2}" />
    <xacro:property name="cogz_4" value="${  7094.8936*unit_factor2}" />
    <xacro:property name="cogx_5" value="${ -3.6473102*unit_factor2}" />
    <xacro:property name="cogy_5" value="${ -6381.2605*unit_factor2}" />
    <xacro:property name="cogz_5" value="${  7094.8936*unit_factor2}" />
    <xacro:property name="cogx_6" value="${ 0.92317158*unit_factor2}" />
    <xacro:property name="cogy_6" value="${  38848.123*unit_factor2}" />
    <xacro:property name="cogz_6" value="${ -19356.271*unit_factor2}" />

    <xacro:property name="cogrx_1" value="${radians(0.000000)}" />
    <xacro:property name="cogry_1" value="${radians( -89.992)}" />
    <xacro:property name="cogrz_1" value="${radians(  -2.738)}" />
    <xacro:property name="cogrx_2" value="${radians(  90.002)}" />
    <xacro:property name="cogry_2" value="${radians(0.000000)}" />
    <xacro:property name="cogrz_2" value="${radians( -0.4087)}" />
    <xacro:property name="cogrx_3" value="${radians(  89.984)}" />
    <xacro:property name="cogry_3" value="${radians(0.000000)}" />
    <xacro:property name="cogrz_3" value="${radians(   0.066)}" />
    <xacro:property name="cogrx_4" value="${radians(0.000000)}" />
    <xacro:property name="cogry_4" value="${radians(  89.977)}" />
    <xacro:property name="cogrz_4" value="${radians(  95.229)}" />
    <xacro:property name="cogrx_5" value="${radians(0.000000)}" />
    <xacro:property name="cogry_5" value="${radians(  89.977)}" />
    <xacro:property name="cogrz_5" value="${radians(  84.771)}" />
    <xacro:property name="cogrx_6" value="${radians(-142.064)}" />
    <xacro:property name="cogry_6" value="${radians(  89.631)}" />
    <xacro:property name="cogrz_6" value="${radians( -103.01)}" />

    <xacro:property name="specified_color_arms" default="false" />
    <xacro:property name="prefix_monochrome_command" default="true" />

    <!-- If other applications conflict with the color definition of URDF, try disable_prefix_color to close it -->
    <xacro:property name="disable_prefix_color" default="false" />
    <xacro:if value="${disable_prefix_color}">
      <prefix_monochrome_command value="false"/>
    </xacro:if>
    <xacro:if value="${format == 'stl'}">
      <specified_color_arms value="true"/>
      <prefix_monochrome_command value="false"/>
    </xacro:if>
    <xacro:if value="${format == 'dae'}">
      <specified_color_arms value="false"/>
      <prefix_monochrome_command value="false"/>
    </xacro:if>
    <xacro:if value="${prefix_monochrome_command}">
      <xacro:tm_materials/>
    </xacro:if>

    <!--LinkDescription-->
    <link name="${prefix}base_link">
      <visual>
        <geometry>
          <mesh filename="file://$(find tm12s_description)/meshes/tm12s/visual/link0.${format}" />
        </geometry>
        <xacro:if value="${specified_color_arms}">
          <xacro:tm_material_whitegraphite />
        </xacro:if>
        <xacro:if value="${prefix_monochrome_command}">
          <material name="${color}" />
        </xacro:if>
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find tm12s_description)/meshes/tm12s/collision/link0_c.stl" />
        </geometry>
      </collision>
      <xacro:cylinder_inertial_z radius="0.06" length="0.05" mass="${mass_0}">
        <origin rpy="0.000000 0.000000 0.000000" xyz="0.000000 0.000000 0.000000" />
      </xacro:cylinder_inertial_z>
    </link>
    <joint name="${prefix}joint_1" type="revolute">
      <parent link="${prefix}base_link" />
      <child link="${prefix}link_1" />
      <origin rpy="0.000000 -0.000000 0.000000" xyz="0.000000 0.000000 0.165200" />
      <axis xyz="0 0 1" />
      <limit lower="${joint_1_lower_limit}" upper="${joint_1_upper_limit}" velocity="${joint_1_velocity_limit}" effort="${joint_1_effort_limit}" />
      <xacro:if value="${safety_limits}">
        <safety_controller soft_lower_limit="${joint_1_lower_limit + safety_pos_margin}" soft_upper_limit="${joint_1_upper_limit - safety_pos_margin}" k_position="${safety_k_position}" k_velocity="0.0" />
      </xacro:if>
      <dynamics damping="${d1}" friction="${f1}" />
    </joint>
    <link name="${prefix}link_1">
      <visual>
        <geometry>
          <mesh filename="file://$(find tm12s_description)/meshes/tm12s/visual/link1.${format}" />
        </geometry>
        <xacro:if value="${specified_color_arms}">
          <xacro:tm_material_darkolive />
        </xacro:if>
        <xacro:if value="${prefix_monochrome_command}">
          <material name="${color}" />
        </xacro:if>
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find tm12s_description)/meshes/tm12s/collision/link1_c.stl" />
        </geometry>
      </collision>
      <inertial>
        <mass value="${mass_1}" />
        <origin rpy="${cogrx_1} ${cogry_1} ${cogrz_1}" xyz="${cogx_1} ${cogy_1} ${cogz_1}" />
      <inertia ixx="${ixx_1}" ixy="0.000000" ixz="0.000000" iyy="${iyy_1}" iyz="0.000000" izz="${izz_1}" />
      </inertial>
    </link>
    <joint name="${prefix}joint_2" type="revolute">
      <parent link="${prefix}link_1" />
      <child link="${prefix}link_2" />
      <origin rpy="-1.570796 -1.570796 0.000000" xyz="0.000000 0.000000 0.000000" />
      <axis xyz="0 0 1" />
      <limit lower="${joint_2_lower_limit}" upper="${joint_2_upper_limit}" velocity="${joint_2_velocity_limit}" effort="${joint_2_effort_limit}" />
      <xacro:if value="${safety_limits}">
        <safety_controller soft_lower_limit="${joint_2_lower_limit + safety_pos_margin}" soft_upper_limit="${joint_2_upper_limit - safety_pos_margin}" k_position="${safety_k_position}" k_velocity="0.0" />
      </xacro:if>
      <dynamics damping="${d2}" friction="${f2}" />
    </joint>
    <link name="${prefix}link_2">
      <visual>
        <geometry>
          <mesh filename="file://$(find tm12s_description)/meshes/tm12s/visual/link2.${format}" />
        </geometry>
        <xacro:if value="${specified_color_arms}">
          <xacro:tm_material_darkolive />
        </xacro:if>
        <xacro:if value="${prefix_monochrome_command}">
          <material name="${color}" />
        </xacro:if>
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find tm12s_description)/meshes/tm12s/collision/link2_c.stl" />
        </geometry>
      </collision>
      <inertial>
        <mass value="${mass_2}" />
        <origin rpy="${cogrx_2} ${cogry_2} ${cogrz_2}" xyz="${cogx_2} ${cogy_2} ${cogz_2}" />
        <inertia ixx="${ixx_2}" ixy="0.000000" ixz="0.000000" iyy="${iyy_2}" iyz="0.000000" izz="${izz_2}" />
      </inertial>
    </link>
    <joint name="${prefix}joint_3" type="revolute">
      <parent link="${prefix}link_2" />
      <child link="${prefix}link_3" />
      <origin rpy="0.000000 -0.000000 0.000000" xyz="0.636100 0.000000 0.000000" />
      <axis xyz="0 0 1" />
      <limit lower="${joint_3_lower_limit}" upper="${joint_3_upper_limit}" velocity="${joint_3_velocity_limit}" effort="${joint_3_effort_limit}" />
      <xacro:if value="${safety_limits}">
        <safety_controller soft_lower_limit="${joint_3_lower_limit + safety_pos_margin}" soft_upper_limit="${joint_3_upper_limit - safety_pos_margin}" k_position="${safety_k_position}" k_velocity="0.0" />
      </xacro:if>
      <dynamics damping="${d3}" friction="${f3}" />
    </joint>
    <link name="${prefix}link_3">
      <visual>
        <geometry>
          <mesh filename="file://$(find tm12s_description)/meshes/tm12s/visual/link3.${format}" />
        </geometry>
        <xacro:if value="${specified_color_arms}">
          <xacro:tm_material_gold />
        </xacro:if>
        <xacro:if value="${prefix_monochrome_command}">
          <material name="${color}" />
        </xacro:if>
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find tm12s_description)/meshes/tm12s/collision/link3_c.stl" />
        </geometry>
      </collision>
      <inertial>
        <mass value="${mass_3}" />
        <origin rpy="${cogrx_3} ${cogry_3} ${cogrz_3}" xyz="${cogx_3} ${cogy_3} ${cogz_3}" />
        <inertia ixx="${ixx_3}" ixy="0.000000" ixz="0.000000" iyy="${iyy_3}" iyz="0.000000" izz="${izz_3}" />
      </inertial>
    </link>
    <joint name="${prefix}joint_4" type="revolute">
      <parent link="${prefix}link_3" />
      <child link="${prefix}link_4" />
      <origin rpy="0.000000 -0.000000 1.570796" xyz="0.532400 0.000000 -0.181800" />
      <axis xyz="0 0 1" />
      <limit lower="${joint_4_lower_limit}" upper="${joint_4_upper_limit}" velocity="${joint_4_velocity_limit}" effort="${joint_4_effort_limit}" />
      <xacro:if value="${safety_limits}">
        <safety_controller soft_lower_limit="${joint_4_lower_limit + safety_pos_margin}" soft_upper_limit="${joint_4_upper_limit - safety_pos_margin}" k_position="${safety_k_position}" k_velocity="0.0" />
      </xacro:if>
      <dynamics damping="${d4}" friction="${f4}" />
    </joint>
    <link name="${prefix}link_4">
      <visual>
        <geometry>
          <mesh filename="file://$(find tm12s_description)/meshes/tm12s/visual/link4.${format}" />
        </geometry>
        <xacro:if value="${specified_color_arms}">
          <xacro:tm_material_darkolive />
        </xacro:if>
        <xacro:if value="${prefix_monochrome_command}">
          <material name="${color}" />
        </xacro:if>
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find tm12s_description)/meshes/tm12s/collision/link4_c.stl" />
        </geometry>
      </collision>
      <inertial>
        <mass value="${mass_4}" />
        <origin rpy="${cogrx_4} ${cogry_4} ${cogrz_4}" xyz="${cogx_4} ${cogy_4} ${cogz_4}" />
        <inertia ixx="${ixx_4}" ixy="0.000000" ixz="0.000000" iyy="${iyy_4}" iyz="0.000000" izz="${izz_4}" />
      </inertial>
    </link>
    <joint name="${prefix}joint_5" type="revolute">
      <parent link="${prefix}link_4" />
      <child link="${prefix}link_5" />
      <origin rpy="1.570796 -0.000000 0.000000" xyz="0.000000 -0.131500 0.000000" />
      <axis xyz="0 0 1" />
      <limit lower="${joint_5_lower_limit}" upper="${joint_5_upper_limit}" velocity="${joint_5_velocity_limit}" effort="${joint_5_effort_limit}" />
      <xacro:if value="${safety_limits}">
        <safety_controller soft_lower_limit="${joint_5_lower_limit + safety_pos_margin}" soft_upper_limit="${joint_5_upper_limit - safety_pos_margin}" k_position="${safety_k_position}" k_velocity="0.0" />
      </xacro:if>
      <dynamics damping="${d5}" friction="${f5}" />
    </joint>
    <link name="${prefix}link_5">
      <visual>
        <geometry>
          <mesh filename="file://$(find tm12s_description)/meshes/tm12s/visual/link5.${format}" />
        </geometry>
        <xacro:if value="${specified_color_arms}">
          <xacro:tm_material_darkolive />
        </xacro:if>
        <xacro:if value="${prefix_monochrome_command}">
          <material name="${color}" />
        </xacro:if>
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find tm12s_description)/meshes/tm12s/collision/link5_c.stl" />
        </geometry>
      </collision>
      <inertial>
        <mass value="${mass_5}" />
        <origin rpy="${cogrx_5} ${cogry_5} ${cogrz_5}" xyz="${cogx_5} ${cogy_5} ${cogz_5}" />
        <inertia ixx="${ixx_5}" ixy="0.000000" ixz="0.000000" iyy="${iyy_5}" iyz="0.000000" izz="${izz_5}" />
      </inertial>
    </link>
    <joint name="${prefix}joint_6" type="revolute">
      <parent link="${prefix}link_5" />
      <child link="${prefix}link_6" />
      <origin rpy="1.570796 -0.000000 0.000000" xyz="0.000000 -0.134950 0.000000" />
      <axis xyz="0 0 1" />
      <limit lower="${joint_6_lower_limit}" upper="${joint_6_upper_limit}" velocity="${joint_6_velocity_limit}" effort="${joint_6_effort_limit}" />
      <xacro:if value="${safety_limits}">
        <safety_controller soft_lower_limit="${joint_6_lower_limit + safety_pos_margin}" soft_upper_limit="${joint_6_upper_limit - safety_pos_margin}" k_position="${safety_k_position}" k_velocity="0.0" />
      </xacro:if>
      <dynamics damping="${d6}" friction="${f6}" />
    </joint>
    <link name="${prefix}link_6">
      <visual>
        <geometry>
          <mesh filename="file://$(find tm12s_description)/meshes/tm12s/visual/link6.${format}" />
        </geometry>
        <xacro:if value="${specified_color_arms}">
          <xacro:tm_material_purewhite />
        </xacro:if>
        <xacro:if value="${prefix_monochrome_command}">
          <material name="${color}" />
        </xacro:if>
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find tm12s_description)/meshes/tm12s/collision/link6_c.stl" />
        </geometry>
      </collision>
      <inertial>
        <mass value="${mass_6}" />
        <origin rpy="${cogrx_6} ${cogry_6} ${cogrz_6}" xyz="${cogx_6} ${cogy_6} ${cogz_6}" />
        <inertia ixx="${ixx_6}" ixy="0.000000" ixz="0.000000" iyy="${iyy_6}" iyz="0.000000" izz="${izz_6}" />
      </inertial>
    </link>

    <link name="${prefix}ft_frame"/>
    <joint name="${prefix}link_6-ft_frame" type="fixed">
      <parent link="${prefix}link_6"/>
      <child link="${prefix}ft_frame"/>
      <origin rpy="0.000000 0.000000 0.000000" xyz="0.000000 0.000000 0.000000" />
    </joint>

    <xacro:unless value="${dae_parse_gzskin}">
    <!-- gazebo material to the link -->
    <gazebo reference="base_link">
      <visual>
        <material>
          <ambient>0.941 0.929 0.882 1</ambient>
          <diffuse>0.941 0.929 0.882 1</diffuse>
          <specular>0.941 0.929 0.882 1</specular>
        </material>
      </visual>
    </gazebo>

    <gazebo reference="link_1">
      <visual>
        <material>
          <ambient>0.400 0.400 0.400 1</ambient>
          <diffuse>0.400 0.400 0.400 1</diffuse>
          <specular>0.400 0.400 0.400 1</specular>
        </material>
      </visual>
    </gazebo>

    <gazebo reference="link_2">
      <visual>
        <material>
          <ambient>0.400 0.400 0.400 1</ambient>
          <diffuse>0.400 0.400 0.400 1</diffuse>
          <specular>0.400 0.400 0.400 1</specular>
        </material>
      </visual>
    </gazebo>

    <gazebo reference="link_3">
      <visual>
        <material>
          <ambient>0.400 0.400 0.400 1</ambient>
          <diffuse>0.400 0.400 0.400 1</diffuse>
          <specular>0.400 0.400 0.400 1</specular>
        </material>
      </visual>
    </gazebo>

    <gazebo reference="link_4">
      <visual>
        <material>
          <ambient>0.400 0.400 0.400 1</ambient>
          <diffuse>0.400 0.400 0.400 1</diffuse>
          <specular>0.400 0.400 0.400 1</specular>
        </material>
      </visual>
    </gazebo>

    <gazebo reference="link_5">
      <visual>
        <material>
          <ambient>0.400 0.400 0.400 1</ambient>
          <diffuse>0.400 0.400 0.400 1</diffuse>
          <specular>0.400 0.400 0.400 1</specular>
        </material>
      </visual>
    </gazebo>

    <gazebo reference="link_6">
      <visual>
        <material>
          <ambient>0.941 0.929 0.882 1</ambient>
          <diffuse>0.941 0.929 0.882 1</diffuse>
          <specular>0.941 0.929 0.882 1</specular>
        </material>
      </visual>
    </gazebo>
    </xacro:unless>

    <!-- 'base' frame - base_link to base/World Coordinates transform -->
    <link name="${prefix}base" />
    <joint name="${prefix}base_link-base" type="fixed">
      <parent link="${prefix}base_link" />
      <child link="${prefix}base" />
      <origin rpy="0.000000 0.000000 0.000000" xyz="0.000000 0.000000 0.000000" />
    </joint>

    <!-- 'flange' frame - attachment point for EEF models -->
    <link name="${prefix}flange" />
    <joint name="${prefix}joint_6-flange" type="fixed">
      <parent link="${prefix}link_6" />
      <child link="${prefix}flange" />
      <origin rpy="0.000000 0.000000 0.000000" xyz="0.000000 0.000000 0.000000" />
    </joint>

    <!-- 'tool0' frame - all-zeros tool frame -->
    <link name="${prefix}tool0" />
    <joint name="${prefix}flange-tool0" type="fixed">
      <parent link="${prefix}flange" />
